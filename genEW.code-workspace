{
  "folders": [
    {
      "name": "Empery",
      "path": "."
    },
    {
      "name": "ECC UI",
      "path": "apps/empery_control_center"
    },
    {
      "name": "Desktop UI",
      "path": "apps/empery_desktop"
    },
    {
      "name": "Services",
      "path": "services"
    },
    {
      "name": "Core",
      "path": "core"
    },
    {
      "name": "Deploy",
      "path": "deploy"
    },
    {
      "name": "Cursor Meta",
      "path": ".cursor"
    },
    {
      "name": "Scripts",
      "path": "scripts"
    },
    {
      "name": "Reference EliteEW",
      "path": "reference/eliteew"
    }
  ],
  "settings": {
    "window.title": "Empery · ${rootName}${separator}${activeEditorShort}",
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.autoSave": "onFocusChange",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": false,
    "editor.rulers": [100],
    "editor.wordWrap": "off",
    "editor.stickyScroll.enabled": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.inlineSuggest.enabled": true,
    "editor.linkedEditing": true,
    "editor.renderWhitespace": "selection",
    "editor.suggestSelection": "first",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "never"
    },
    "workbench.iconTheme": "material-icon-theme",
    "workbench.editor.enablePreview": false,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.tree.indent": 14,
    "explorer.confirmDelete": true,
    "explorer.confirmDragAndDrop": false,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
      "package.json": "package-lock.json, pnpm-lock.yaml, yarn.lock, .npmrc, biome.json, tsconfig*.json, vite.config.*, tailwind.config.*, postcss.config.*, playwright.config.*",
      "manifest.json": "config.py, alembic.ini",
      "compose.yml": "compose.*.yml, .env.example",
      "*.tsx": "${capture}.ts, ${capture}.css, ${capture}.module.css",
      "*.py": "${capture}.pyi"
    },
    "search.followSymlinks": false,
    "search.useIgnoreFiles": true,
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.data": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.mypy_cache": true,
      "**/.ruff_cache": true,
      "**/test-results": true,
      "**/pnpm-lock.yaml": true,
      "**/package-lock.json": true,
      "apps/**/dist": true,
      ".cursor/orchestration/jobs/**": true,
      ".cursor/orchestration/audit/**": true,
      ".cursor/orchestration/eic/intentions/**": true
    },
    "files.exclude": {
      "**/.DS_Store": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/*.pyc": true
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/.data/**": true,
      "**/__pycache__/**": true,
      ".cursor/orchestration/jobs/**": true,
      ".cursor/orchestration/audit/**": true
    },
    "files.associations": {
      "*.mdc": "markdown",
      "compose*.yml": "dockercompose",
      "compose*.yaml": "dockercompose",
      "*.yml": "yaml",
      ".env*": "dotenv",
      "**/manifest.json": "jsonc"
    },
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.tabSize": 4,
      "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports.ruff": "explicit"
      }
    },
    "[typescript]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.tabSize": 2
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.tabSize": 2
    },
    "[javascript]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.tabSize": 2
    },
    "[javascriptreact]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.tabSize": 2
    },
    "[json]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.tabSize": 2
    },
    "[jsonc]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.tabSize": 2
    },
    "[yaml]": {
      "editor.tabSize": 2,
      "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[dockercompose]": {
      "editor.tabSize": 2
    },
    "[markdown]": {
      "editor.wordWrap": "on",
      "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    "[shellscript]": {
      "editor.defaultFormatter": "foxundermoon.shell-format",
      "editor.tabSize": 2
    },
    "python.languageServer": "None",
    "python.analysis.typeCheckingMode": "off",
    "python.defaultInterpreterPath": "${workspaceFolder:Empery}/.venv/bin/python",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
      "services",
      "core",
      "-q"
    ],
    "python.terminal.activateEnvironment": true,
    "basedpyright.analysis.configFilePath": "${workspaceFolder:Empery}",
    "basedpyright.analysis.diagnosticMode": "workspace",
    "basedpyright.importStrategy": "fromEnvironment",
    "ruff.enable": true,
    "ruff.organizeImports": true,
    "ruff.fixAll": true,
    "ruff.lint.run": "onSave",
    "biome.enabled": true,
    "biome.requireConfiguration": false,
    "tailwindCSS.experimental.classRegex": [
      ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"],
      ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"]
    ],
    "tailwindCSS.includeLanguages": {
      "typescriptreact": "html",
      "typescript": "html"
    },
    "yaml.validate": true,
    "yaml.format.enable": true,
    "yaml.customTags": [],
    "evenBetterToml.formatter.alignEntries": false,
    "evenBetterToml.formatter.reorderKeys": false,
    "[toml]": {
      "editor.defaultFormatter": "tamasfe.even-better-toml",
      "editor.tabSize": 2
    },
    "dotenv.enableAutocloaking": false,
    "telemetry.telemetryLevel": "off",
    "telemetry.enableTelemetry": false,
    "telemetry.enableCrashReporter": false,
    "redhat.telemetry.enabled": false,
    "gitlens.telemetry.enabled": false,
    "git.autofetch": false,
    "git.autofetchPeriod": 180,
    "git.confirmSync": true,
    "git.allowForcePush": false,
    "git.allowNoVerifyCommit": false,
    "git.postCommitCommand": "none",
    "git.enableSmartCommit": false,
    "git.pushTags": false,
    "git.fetchOnPull": false,
    "git.openRepositoryInParentFolders": "never",
    "git.showPushSuccessNotification": true,
    "remote.autoForwardPorts": false,
    "remote.downloadExtensionsLocally": true,
    "gitlens.currentLine.enabled": true,
    "gitlens.codeLens.enabled": true,
    "gitlens.codeLens.authors.enabled": true,
    "gitlens.hovers.currentLine.over": "line",
    "gitlens.statusBar.enabled": true,
    "gitlens.views.repositories.files.layout": "tree",
    "gitlens.views.commitDetails.files.layout": "tree",
    "gitlens.plusFeatures.enabled": false,
    "gitlens.cloudPatches.enabled": false,
    "gitlens.ai.enabled": false,
    "gitlens.launchpad.enabled": false,
    "gitlens.graph.layout": "editor",
    "githubPullRequests.enabled": false,
    "githubPullRequests.pullBranch": "never",
    "githubPullRequests.createOnPublishBranch": "never",
    "githubPullRequests.fileListLayout": "tree",
    "githubIssues.queries": [],
    "github-enterprise.uri": "",
    "diffEditor.ignoreTrimWhitespace": false,
    "terminal.integrated.cwd": "${workspaceFolder:Empery}",
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.env.linux": {
      "PYTHONPATH": "${workspaceFolder:Empery}"
    },
    "errorLens.enabled": true,
    "errorLens.delay": 400,
    "errorLens.enabledDiagnosticLevels": ["error", "warning", "info"],
    "errorLens.gutterIconsEnabled": true,
    "shellcheck.enable": true,
    "shellcheck.run": "onType",
    "shellcheck.exclude": ["SC1090", "SC1091"],
    "shell-format.path": "",
    "cSpell.enabled": true,
    "cSpell.language": "en,ru",
    "cSpell.import": ["${workspaceFolder:Empery}/.vscode/cspell.json"],
    "cSpell.enableFiletypes": [
      "markdown",
      "python",
      "typescript",
      "typescriptreact",
      "javascript",
      "javascriptreact",
      "json",
      "jsonc",
      "yaml",
      "dockercompose",
      "shellscript"
    ],
    "cSpell.diagnosticLevel": "Hint",
    "cSpell.words": [
      "Empery",
      "Nervas",
      "Alembic",
      "FastAPI",
      "uvicorn",
      "psycopg",
      "dedmoroz",
      "ewa",
      "i18next",
      "TipTap",
      "ComfyUI",
      "podman",
      "proxychains",
      "genEW",
      "EliteEW",
      "bloknot",
      "дашборд",
      "канбан",
      "жизненный",
      "scaffold",
      "alembic",
      "healthz",
      "readyz",
      "livez",
      "EventBus",
      "ServiceContainer",
      "NervasProvider",
      "IdentityVerifier",
      "maket",
      "proxychains"
    ],
    "cSpell.ignorePaths": [
      "**/node_modules/**",
      "**/dist/**",
      "**/pnpm-lock.yaml",
      "**/package-lock.json",
      "**/.data/**",
      "**/reference/eliteew/**"
    ],
    "todo-tree.general.tags": [
      "BUG",
      "HACK",
      "FIXME",
      "TODO",
      "XXX",
      "BLOCK",
      "DEBT"
    ],
    "todo-tree.highlights.enabled": true,
    "todo-tree.filtering.excludeGlobs": [
      "**/node_modules/**",
      "**/dist/**",
      "**/reference/eliteew/**",
      "**/.data/**"
    ],
    "todo-tree.tree.showCountsInTree": true,
    "markdownlint.config": {
      "MD013": false,
      "MD033": false,
      "MD041": false
    },
    "markdown.preview.breaks": true,
    "markdown-mermaid.languages": ["mermaid"],
    "material-icon-theme.activeIconPack": "react",
    "material-icon-theme.folders.theme": "specific",
    "playwright.reuseBrowser": true,
    "playwright.showTrace": false,
    "playwright.env": {},
    "vitest.enable": true,
    "vitest.commandLine": "npx vitest",
    "containers.environment": "podman",
    "containers.composeCommand": "podman compose",
    "rest-client.enableTelemetry": false,
    "rest-client.previewOption": "exchange",
    "rest-client.timeoutinmilliseconds": 10000,
    "rest-client.environmentVariables": {
      "$shared": {
        "eic": "http://127.0.0.1:8007",
        "ecc": "http://127.0.0.1:8006",
        "desktopShell": "http://127.0.0.1:8020",
        "desktopUi": "http://127.0.0.1:5174",
        "eccUi": "http://127.0.0.1:5173"
      },
      "local": {
        "eic": "http://127.0.0.1:8007",
        "ecc": "http://127.0.0.1:8006",
        "desktopShell": "http://127.0.0.1:8020"
      }
    },
    "rest-client.defaultHeaders": {
      "Accept": "application/json"
    },
    "editor.experimentalGpuAcceleration": "off",
    "workbench.localHistory.maxFileEntries": 100
  },
  "extensions": {
    "recommendations": [
      "detachhead.basedpyright",
      "ms-python.python",
      "ms-python.debugpy",
      "charliermarsh.ruff",
      "biomejs.biome",
      "bradlc.vscode-tailwindcss",
      "redhat.vscode-yaml",
      "ms-azuretools.vscode-containers",
      "usernamehw.errorlens",
      "pkief.material-icon-theme",
      "timonwong.shellcheck",
      "vitest.explorer",
      "eamodio.gitlens",
      "EditorConfig.EditorConfig",
      "tamasfe.even-better-toml",
      "mikestead.dotenv",
      "streetsidesoftware.code-spell-checker",
      "streetsidesoftware.code-spell-checker-russian",
      "DavidAnson.vscode-markdownlint",
      "bierner.markdown-mermaid",
      "ms-playwright.playwright",
      "humao.rest-client",
      "Gruntfuggly.todo-tree",
      "foxundermoon.shell-format"
    ],
    "unwantedRecommendations": [
      "anysphere.cursorpyright",
      "ms-python.vscode-pylance",
      "ms-python.isort",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "GitHub.vscode-pull-request-github",
      "GitHub.copilot",
      "GitHub.copilot-chat",
      "github.remotehub",
      "ms-vscode.remote-repositories",
      "ms-vsliveshare.vsliveshare"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Empery: diversity proof",
        "type": "shell",
        "command": "PYTHONPATH=. python3 scripts/diversity_extract_lifecycle_proof.py",
        "options": {
          "cwd": "${workspaceFolder:Empery}"
        },
        "group": "test",
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        }
      },
      {
        "label": "Empery: pytest EIC diversity+lifecycle",
        "type": "shell",
        "command": "PYTHONPATH=. python3 -m pytest services/empery_intelligence_core/tests/test_recipe_diversity_matchers.py services/empery_intelligence_core/tests/test_service_factory_lifecycle.py -q --tb=line -k 'not desktop_shell'",
        "options": {
          "cwd": "${workspaceFolder:Empery}"
        },
        "group": "test"
      },
      {
        "label": "Desktop: build",
        "type": "shell",
        "command": "pnpm run build",
        "options": {
          "cwd": "${workspaceFolder:Desktop UI}"
        },
        "group": "build"
      },
      {
        "label": "ECC: typecheck",
        "type": "shell",
        "command": "pnpm run typecheck",
        "options": {
          "cwd": "${workspaceFolder:ECC UI}"
        },
        "group": "build"
      },
      {
        "label": "Stack: podman compose ps",
        "type": "shell",
        "command": "podman compose ps",
        "options": {
          "cwd": "${workspaceFolder:Empery}"
        },
        "problemMatcher": []
      },
      {
        "label": "Health: EIC + ECC + Desktop shell",
        "type": "shell",
        "command": "curl -sS --max-time 5 http://127.0.0.1:8007/api/v1/health; echo; curl -sS --max-time 5 http://127.0.0.1:8006/api/v1/health; echo; curl -sS --max-time 5 -o /dev/null -w 'desktop_shell:%{http_code}\\n' http://127.0.0.1:8020/api/v1/shell-bootstrap; curl -sS --max-time 5 -o /dev/null -w 'desktop_ui:%{http_code}\\n' http://127.0.0.1:5174/",
        "options": {
          "cwd": "${workspaceFolder:Empery}"
        },
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Python: current file",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "cwd": "${workspaceFolder:Empery}",
        "env": {
          "PYTHONPATH": "${workspaceFolder:Empery}"
        },
        "justMyCode": true
      },
      {
        "name": "Python: pytest (current file)",
        "type": "debugpy",
        "request": "launch",
        "module": "pytest",
        "args": [
          "${file}",
          "-q",
          "--tb=short"
        ],
        "cwd": "${workspaceFolder:Empery}",
        "env": {
          "PYTHONPATH": "${workspaceFolder:Empery}"
        },
        "justMyCode": false
      }
    ]
  }
}
