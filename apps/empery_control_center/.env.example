# Empery Control Center API (FastAPI gateway — default port 8006)
# Localhost for `npm run dev` on the same machine:
#   VITE_ECC_API_BASE=http://localhost:8006
# LAN / other hosts: use the Empery host IP (not the client IP).
# Example — stack on 192.168.1.136, browser on 192.168.8.10:
VITE_ECC_API_BASE=http://192.168.1.136:8006

# WebSocket events stream
VITE_ECC_WS_URL=ws://192.168.1.136:8006/api/v1/ws/events
