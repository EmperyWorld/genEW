{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DashboardModule",
  "type": "object",
  "required": ["layout", "theme"],
  "properties": {
    "layout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component_id", "widget_type"],
        "properties": {
          "component_id": {
            "type": "string",
            "enum": ["grid_item", "sidebar", "header"]
          },
          "widget_type": {
            "type": "string",
            "enum": ["card", "chart", "table", "metric"]
          },
          "position": {
            "type": "object",
            "properties": {
              "x": { "type": "integer" },
              "y": { "type": "integer" }
            }
          }
        }
      }
    },
    "theme": {
      "type": "string",
      "enum": ["light", "dark", "system"]
    }
  }
}
