{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompanionModule",
  "type": "object",
  "required": ["layout", "theme"],
  "properties": {
    "layout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component_id", "widget_type"],
        "properties": {
          "component_id": { "type": "string", "minLength": 1 },
          "widget_type": {
            "type": "string",
            "enum": ["message_list", "composer"]
          }
        }
      }
    },
    "theme": {
      "type": "string",
      "enum": ["light", "dark", "system"]
    }
  }
}
