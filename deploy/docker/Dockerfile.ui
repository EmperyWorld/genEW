# syntax=docker/dockerfile:1
# Empery Control Center UI — multi-stage build + unprivileged nginx.
# Tip: export BUILDAH_FORMAT=docker so HEALTHCHECK is retained under Podman.

FROM docker.io/library/node:22-bookworm-slim AS build

WORKDIR /app
COPY apps/empery_control_center/package.json \
     apps/empery_control_center/package-lock.json* \
     apps/empery_control_center/pnpm-lock.yaml* \
     apps/empery_control_center/pnpm-workspace.yaml* \
     ./
RUN if [ -f pnpm-lock.yaml ]; then \
      corepack enable && corepack prepare pnpm@latest --activate \
      && pnpm install --frozen-lockfile; \
    elif [ -f package-lock.json ]; then npm ci; \
    else npm install; fi
COPY apps/empery_control_center/ ./

# Bake API URL for browser clients (host-facing ECC port).
ARG VITE_ECC_API_BASE=http://localhost:8006
ARG VITE_ECC_WS_URL=ws://localhost:8006/api/v1/ws/events
ENV VITE_ECC_API_BASE=${VITE_ECC_API_BASE} \
    VITE_ECC_WS_URL=${VITE_ECC_WS_URL}

RUN if command -v pnpm >/dev/null 2>&1; then pnpm run build; else npm run build; fi

FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY deploy/docker/nginx-ecc.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
USER 101

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
