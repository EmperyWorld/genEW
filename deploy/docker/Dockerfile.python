# syntax=docker/dockerfile:1
# Empery Python service image — multi-stage, rootless Podman friendly (UID 1000).
# Build: podman build --format docker -f deploy/docker/Dockerfile.python --target runtime \
#   --build-arg SERVICE_APP=... --build-arg SERVICE_PORT=... -t empery/<svc> .
# Tip: export BUILDAH_FORMAT=docker so HEALTHCHECK is retained under Podman.

FROM docker.io/library/python:3.12-slim-bookworm AS deps

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.runtime.txt /tmp/requirements.runtime.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /tmp/requirements.runtime.txt

FROM docker.io/library/python:3.12-slim-bookworm AS runtime

ARG SERVICE_APP=services.core_auth_service.src.api.main:create_app
ARG SERVICE_PORT=8001

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    SERVICE_APP=${SERVICE_APP} \
    PORT=${SERVICE_PORT} \
    LOG_LEVEL=INFO

RUN groupadd --gid 1000 empery \
    && useradd --uid 1000 --gid empery --create-home --shell /usr/sbin/nologin empery \
    && mkdir -p /app /data /var/log/empery \
    && chown -R empery:empery /app /data /var/log/empery

COPY --from=deps /opt/venv /opt/venv

WORKDIR /app
COPY --chown=empery:empery core /app/core
COPY --chown=empery:empery services /app/services

USER 1000:1000
EXPOSE ${SERVICE_PORT}

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:'+__import__('os').environ.get('PORT','8000')+'/api/v1/health', timeout=3)" || exit 1

CMD ["sh", "-c", "exec uvicorn ${SERVICE_APP} --factory --host 0.0.0.0 --port ${PORT}"]
