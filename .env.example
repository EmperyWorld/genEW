# Empery Grand Convergence — copy to .env before podman-compose up
#   cp .env.example .env
#
# REQUIRED secrets (no weak defaults — generate before first deploy):
#   export POSTGRES_PASSWORD="$(openssl rand -hex 32)"
#   export IDENTITY_JWT_SECRET="$(openssl rand -hex 32)"
# Or lab stand for a stranger machine (autonomy ON):
#   ./scripts/ew2_one_click_deploy.sh --lab
# See PODMAN.md § «From zero to green smoke (lab)».
#
# Or let ./scripts/ew2_one_click_deploy.sh generate them on first run (non-strict).
#
# Schema: AUTO_CREATE_TABLES=false in compose. Migrations run via deploy script:
#   alembic -c services/<service>/alembic.ini upgrade head  (per Postgres DB)
#
# === PRODUCTION CHECKLIST (--strict deploy) ===
# Set EMPERY_ENV=production (or staging|prod) before ./scripts/ew2_one_click_deploy.sh --strict
# [ ] POSTGRES_PASSWORD and IDENTITY_JWT_SECRET set (openssl rand -hex 32)
# [ ] EMPERY_ENV=production (or staging|prod) — identity rejects weak JWT secrets
# [ ] ECC_REQUIRE_AUTH=true (compose default; lab sets false)
# [ ] SEED_DEMO_USER=false (no legacy demo admin seed)
# [ ] SEED_OPERATOR_PASSWORD set for first-boot operator (or register via UI)
# [ ] INTELLIGENCE_USE_FAKE_AI=false, AI_CHAT_FALLBACK_FAKE=false, EIC_USE_FAKE_NERVAS=false
# [ ] EVENT_BUS_ALLOW_IN_MEMORY=false (compose hardcodes; never enable in-memory bus in prod)
# [ ] AUTO_CREATE_TABLES=false (compose hardcodes; Alembic-only)
# [ ] reflex_probe_service in main compose.yml (no compose.reflex.yml overlay required)
# [ ] EIC_AUTONOMOUS_ENABLED=false unless ops-approved
# [ ] ./scripts/ew2_one_click_deploy.sh --strict

LOG_LEVEL=INFO

# Deployment profile: development | staging | production|prod
# In production/staging, identity_service refuses weak/short JWT secrets.
# EMPERY_ENV=development

# --- Secrets (REQUIRED — no placeholders in production) ---
# Must be ≥32 UTF-8 bytes. Generate: openssl rand -hex 32
POSTGRES_USER=eworld
POSTGRES_PASSWORD=
IDENTITY_JWT_SECRET=

# --- Identity hardening ---
# Include every browser Origin that may load the UI (localhost + LAN host IP).
IDENTITY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
IDENTITY_RATE_LIMIT_PER_MINUTE=120
# Production/staging: keep false. Prefer SEED_OPERATOR_PASSWORD for empty-DB bootstrap.
SEED_DEMO_USER=false
# Preferred operator bootstrap (identity_service): when users table is empty, seeds admin.
# Generate: openssl rand -base64 24   — never commit the real value.
SEED_OPERATOR_EMAIL=admin@eworld.local
SEED_OPERATOR_PASSWORD=
SEED_OPERATOR_DISPLAY_NAME=Operator

# --- ECC UI (baked into nginx image at build time) ---
# Localhost defaults are portable. For LAN: set host IP, add CORS origins, rebuild UI.
# After changing VITE_* below, rebuild: podman-compose build --no-cache empery_control_center_ui && podman-compose up -d empery_control_center_ui
VITE_ECC_API_BASE=http://127.0.0.1:8006
VITE_ECC_WS_URL=ws://127.0.0.1:8006/api/v1/ws/events
ECC_UI_HOST_PORT=5173
DESKTOP_UI_HOST_PORT=5174
# Browser origin for ECC API CORS (Vite / Control Center UI). Add LAN origins as needed.
ECC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175
# ECC→EIC autonomous proxy (compose service DNS; do not use localhost inside containers)
EIC_API_BASE=http://empery_intelligence_core:8007
# Demo runner stubs (POST /jobs/{id}/run-demo) — keep false in production
ECC_ALLOW_DEMO_RUNNER=false
# ECC auth BFF → identity_service (compose DNS inside containers)
IDENTITY_API_BASE=http://identity_service:8003
# Require Bearer JWT on mutating ECC API routes — true is market default (compose).
# Lab / local demos: set ECC_REQUIRE_AUTH=false to preserve guest write flows.
ECC_REQUIRE_AUTH=true
# Password reset: no SMTP on this seed. Lab overlay sets IDENTITY_PASSWORD_RESET_REVEAL=true.
IDENTITY_PASSWORD_RESET_REVEAL=false
# Publish eic.intention.requested for all lifecycle skills (false = evolve only)
ECC_PUBLISH_EIC_INTENTIONS=true
# Optional override: registry service → HTTP base for GET /api/v1/health/services probes
# (compose default includes reflex_probe_service=http://reflex_probe_service:8035)
# ECC_SERVICE_HEALTH_BASES=identity_service=http://identity_service:8003,empery_intelligence_core=http://empery_intelligence_core:8007,reflex_probe_service=http://reflex_probe_service:8035
# ECC_HEALTH_PROBE_TIMEOUT_MS=2000

# --- Event bus (compose sets Redis; never enable in-memory fallback in prod) ---
EVENT_BUS_ALLOW_IN_MEMORY=false

# --- Living Brain (OpenAI-compatible llama.cpp) ---
# Portable defaults: same-host brain via host.containers.internal (Podman).
# Lab LAN inventory + chat templates: .cursor/orchestration/nervas/
#   primary Gemma :8080 | optional Qwen instruct :8083 | embed/rerank deferred
# LAN peer: set URLs to http://<brain-ip>:8080 (…/v1/chat/completions for AI_CHAT).
# Verify: python3 scripts/verify_living_brain.py
# Do NOT enable compose profile `llm` when using an external brain.
AI_CHAT_BASE_URL=http://host.containers.internal:8080/v1/chat/completions
AI_CHAT_MODEL=/models/gemma-4-26B.gguf
AI_CHAT_API_KEY=
AI_CHAT_TIMEOUT_SECONDS=60
AI_CHAT_MAX_RETRIES=2
INTELLIGENCE_USE_FAKE_AI=false
AI_CHAT_FALLBACK_FAKE=false

EIC_PROVIDER=local
EIC_LLM_BASE_URL=http://host.containers.internal:8080
EIC_LLAMA_MODEL=/models/gemma-4-26B.gguf
# Optional secondary instruct (Qwen3-4B) — not auto-routed yet; document for ops
# EIC_LLM_SECONDARY_BASE_URL=http://192.168.1.141:8083
EIC_USE_FAKE_NERVAS=false
# Memory embeddings: none (default, honest — keyword/FTS only) | stub | local | http
# Living primary brain often has no --embeddings; use dedicated embed host later
# (registry: 192.168.1.141:8081) — keep deferred until wired
EIC_EMBEDDING_BACKEND=none
# Do NOT point http backend at chat-only brain without --embeddings (will 501)
# EIC_EMBEDDING_BASE_URL=http://192.168.1.141:8081
# EIC_RERANK_BASE_URL=http://192.168.1.141:8082
# EIC_EMBEDDING_REQUIRE_REAL=false
# EliteEW live tree for corpus sync (RO) — never write into this path
# ELITEEW_ROOT=/home/owned/powered_by_emperyworld/EliteEW

# Optional in-compose llama (podman-compose --profile llm up -d llama-cpp)
LLAMA_HOST_PORT=8080
LLAMA_IMAGE=ghcr.io/ggerganov/llama.cpp:server
EIC_LLAMA_MODEL_DIR=./.data/eic/models
EIC_LLAMA_MODEL_FILE=/models/model.gguf
LLAMA_CTX=4096

# --- Autonomy (prod-safe defaults) ---
# workspace = file jobs only (no socket). podman_exec requires explicit sock mount override.
EIC_AGENT_EXEC_MODE=workspace
# Market default false. Lab stand: compose.lab.yml or set true here.
EIC_AUTONOMOUS_ENABLED=false
# Reflex Hands: allow Implementer to write under services/** + deploy/services/**
# (sandbox still denies .env, credentials, secrets). Set false for read-only autonomy.
EIC_ENGINE_ALLOW_SERVICE_WRITES=true
EIC_AUTO_SCAFFOLD_ON_IMPLEMENT=true
EIC_AUTO_DEPLOY_ON_IMPLEMENT=true
# Legacy in-EIC compose reflex (off). Primary path is empery_deploy_agent.
EIC_ALLOW_COMPOSE_COMMANDS=false
EIC_DEPLOY_AGENT_URL=http://empery_deploy_agent:8010
# Per-call HTTP timeout to deploy-agent (up/health/UI refresh). Was 600 — too long for event-loop stalls.
EIC_DEPLOY_AGENT_TIMEOUT_S=120
# Mechanics sidecar (compose service empery_assembler). Code + compose default: grpc.
# Opt into in-process only for unit/lab: EIC_ASSEMBLER_TRANSPORT=local
EIC_ASSEMBLER_TRANSPORT=grpc
# Host Brain → container Mechanics (shared bind). Compose both use /app — leave unset.
# EIC_ASSEMBLER_WORKSPACE_MAP=/data/repos/genEW:/app
# Remote Mechanics (no shared FS): Brain requests artifact bytes and materializes locally.
# EIC_ASSEMBLER_SHARED_FS=0
# EIC_ASSEMBLER_CONTENT_TRANSFER=1
EIC_ASSEMBLER_GRPC_TARGET=127.0.0.1:50051
# In compose network: EIC_ASSEMBLER_GRPC_TARGET=empery_assembler:50051
# EIC_ASSEMBLER_GRPC_TIMEOUT_S=300
# Lab: skip Gate T∧C preflight before ECC reload (default off — fail-closed)
# EIC_ASSEMBLY_SKIP_PREFLIGHT=0
# Verifier co-hosted on assembler (Phase 4). Empty → inherit assembler transport/target (default grpc).
# EIC_VERIFIER_TRANSPORT=grpc
# EIC_VERIFIER_GRPC_TARGET=empery_assembler:50051
# ASSEMBLER_GRPC_PORT=50051
# ASSEMBLER_HEALTH_PORT=8011
# asyncio.wait_for budgets around deploy_service / verify_live_presence (P7.2).
EIC_DEPLOY_BLOCKING_BUDGET_S=180
EIC_LIVE_VERIFY_BUDGET_S=150
# Hands Desktop/ECC UI bake (build --no-cache) HTTP timeout
EIC_UI_REBUILD_TIMEOUT_S=600
# ECC vite bake after genesis (defaults to EIC_UI_REBUILD_TIMEOUT_S)
# EIC_ECC_UI_REBUILD_TIMEOUT_S=600
EIC_REQUIRE_DEPLOY_AGENT=true
# Advanced Wizard salvage only — leave unset/false for production CJM
# EMPERY_CURSOR_SALVAGE=0
# Deploy agent host publish is localhost-only (127.0.0.1:8010); peers use DNS :8010.# VITE_EMPERY_CURSOR_SALVAGE=0
# Shared secret for EIC→ECC POST /registry/refresh (market). Empty = lab open refresh.
# Generate: openssl rand -hex 24
EMPERY_MESH_TOKEN=
# Deploy-agent health probe (cold-start patience after compose up)
# DEPLOY_AGENT_HEALTH_TIMEOUT_S=8
# DEPLOY_AGENT_HEALTH_RETRIES=12
# DEPLOY_AGENT_HEALTH_BACKOFF_S=2.0

# --- Deploy / SELinux (Fedora Podman rootless) ---
# One-click: ./scripts/ew2_one_click_deploy.sh
# ECC + EIC run as uid 1000:1000; host orchestration dirs must be owned 1000:1000.
# Shared orchestration bind uses :z (ECC + EIC). Single-consumer binds use :Z.
# Prefer: export BUILDAH_FORMAT=docker before image builds (HEALTHCHECK metadata).
# Never privileged / label=disable / root docker.sock.
# empery_deploy_agent mounts the *user* rootless sock (:z) + path-identity workspace.
# Required: absolute host path to this repo (health → degraded if empty/relative/missing).
EMPERY_HOST_WORKSPACE=
PODMAN_SOCKET=/run/user/1000/podman/podman.sock
